rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInviteCode(code) {
      return code is string && code.size() >= 6 && code.size() <= 12 && code.matches('^[A-Z0-9]+$');
    }

    function isValidDueDate(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidDueTime(val) {
      return val is string && (val.size() == 0 || (val.size() == 5 && val.matches('^[0-2][0-9]:[0-5][0-9]$')));
    }

    function workspaceExists(workspaceId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId));
    }

    function getWorkspace(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
    }

    function isWorkspaceMember(workspaceId) {
      return workspaceExists(workspaceId) && request.auth.uid in getWorkspace(workspaceId).memberIds;
    }

    function hasValidMemberIds(listVal) {
      return listVal is list
        && listVal.size() >= 1
        && listVal.size() <= 2
        && listVal[0] is string
        && listVal[0].size() >= 1
        && listVal[0].size() <= 128
        && (listVal.size() == 1 || (listVal[1] is string && listVal[1].size() >= 1 && listVal[1].size() <= 128 && listVal[1] != listVal[0]));
    }

    // --- Entity Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'photoURL', 'workspaceId', 'theme', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'workspaceId', 'theme', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.email is string && data.email.size() <= 150
        && data.photoURL is string && data.photoURL.size() <= 500
        && isValidId(data.workspaceId)
        && data.theme in ['light', 'dark']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkspace(data) {
      return data.keys().hasAll([
          'id', 'name', 'ownerId', 'ownerName', 'ownerPhoto',
          'partnerId', 'partnerName', 'partnerPhoto',
          'memberIds', 'inviteCode', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'ownerId', 'ownerName', 'ownerPhoto',
          'partnerId', 'partnerName', 'partnerPhoto',
          'memberIds', 'inviteCode', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && isValidId(data.ownerId)
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 80
        && data.ownerPhoto is string && data.ownerPhoto.size() <= 500
        && data.partnerId is string && data.partnerId.size() <= 128
        && data.partnerName is string && data.partnerName.size() <= 80
        && data.partnerPhoto is string && data.partnerPhoto.size() <= 500
        && hasValidMemberIds(data.memberIds)
        && data.memberIds[0] == data.ownerId
        && (
          (data.partnerId == '' && data.memberIds.size() == 1) ||
          (isValidId(data.partnerId) && data.partnerId != data.ownerId && data.memberIds.size() == 2 && data.memberIds[1] == data.partnerId)
        )
        && isValidInviteCode(data.inviteCode)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInvite(data) {
      return data.keys().hasAll(['code', 'workspaceId', 'ownerId', 'ownerName', 'createdAt'])
        && data.keys().hasOnly(['code', 'workspaceId', 'ownerId', 'ownerName', 'createdAt'])
        && isValidInviteCode(data.code)
        && isValidId(data.workspaceId)
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidTask(data) {
      return data.keys().hasAll([
          'id', 'workspaceId', 'memberIds', 'title', 'description',
          'priority', 'categoryId', 'categoryName', 'dueDate', 'dueTime',
          'assignee', 'completed', 'completedBy', 'completedByName',
          'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'workspaceId', 'memberIds', 'title', 'description',
          'priority', 'categoryId', 'categoryName', 'dueDate', 'dueTime',
          'assignee', 'completed', 'completedBy', 'completedByName',
          'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.workspaceId)
        && hasValidMemberIds(data.memberIds)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.description is string && data.description.size() <= 500
        && data.priority in ['high', 'medium', 'low']
        && data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 64
        && data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 40
        && isValidDueDate(data.dueDate)
        && isValidDueTime(data.dueTime)
        && data.assignee is string && data.assignee.size() >= 1 && data.assignee.size() <= 128
        && data.completed is bool
        && data.completedBy is string && data.completedBy.size() <= 128
        && data.completedByName is string && data.completedByName.size() <= 80
        && isValidId(data.createdBy)
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'workspaceId', 'memberIds', 'name', 'color', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'workspaceId', 'memberIds', 'name', 'color', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.workspaceId)
        && hasValidMemberIds(data.memberIds)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 40
        && data.color in ['teal', 'amber', 'rose', 'sky', 'indigo', 'emerald', 'slate']
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // Private User Profiles (PII isolated to owner only)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'workspaceId', 'theme', 'updatedAt']);
      allow delete: if false;
    }

    // Shared Workspaces (up to 2 members)
    match /workspaces/{workspaceId} {
      allow get: if isSignedIn() && isValidId(workspaceId) && request.auth.uid in existing().memberIds;
      allow list: if isSignedIn() && request.auth.uid in existing().memberIds;
      allow create: if isVerifiedUser()
        && isValidId(workspaceId)
        && isValidWorkspace(incoming())
        && incoming().id == workspaceId
        && incoming().ownerId == request.auth.uid
        && incoming().partnerId == ''
        && incoming().memberIds.size() == 1
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(workspaceId)
        && isValidWorkspace(incoming())
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update workspace name or owner profile snapshot
          (
            request.auth.uid == existing().ownerId
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'ownerName', 'ownerPhoto', 'updatedAt'])
          )
          ||
          // Action: Partner updates their own profile snapshot
          (
            request.auth.uid == existing().partnerId
            && incoming().diff(existing()).affectedKeys().hasOnly(['partnerName', 'partnerPhoto', 'updatedAt'])
          )
          ||
          // Action: Owner regenerates invite code
          (
            request.auth.uid == existing().ownerId
            && incoming().diff(existing()).affectedKeys().hasOnly(['inviteCode', 'updatedAt'])
          )
          ||
          // Action: Second user joins via valid invite code
          (
            existing().partnerId == ''
            && existing().memberIds.size() == 1
            && request.auth.uid != existing().ownerId
            && incoming().partnerId == request.auth.uid
            && incoming().memberIds.size() == 2
            && incoming().memberIds[1] == request.auth.uid
            && exists(/databases/$(database)/documents/invites/$(existing().inviteCode))
            && get(/databases/$(database)/documents/invites/$(existing().inviteCode)).data.workspaceId == workspaceId
            && incoming().diff(existing()).affectedKeys().hasOnly(['partnerId', 'partnerName', 'partnerPhoto', 'memberIds', 'updatedAt'])
          )
          ||
          // Action: Owner removes partner or partner leaves workspace
          (
            existing().partnerId != ''
            && (request.auth.uid == existing().ownerId || request.auth.uid == existing().partnerId)
            && incoming().partnerId == ''
            && incoming().partnerName == ''
            && incoming().partnerPhoto == ''
            && incoming().memberIds.size() == 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['partnerId', 'partnerName', 'partnerPhoto', 'memberIds', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(workspaceId) && existing().ownerId == request.auth.uid;

      // Tasks subcollection (Master Gate + O(1) list query)
      match /tasks/{taskId} {
        allow get: if isSignedIn()
          && isValidId(workspaceId)
          && isValidId(taskId)
          && request.auth.uid in existing().memberIds
          && isWorkspaceMember(workspaceId);
        allow list: if isSignedIn() && request.auth.uid in existing().memberIds;
        allow create: if isVerifiedUser()
          && isValidId(workspaceId)
          && isValidId(taskId)
          && isValidTask(incoming())
          && incoming().id == taskId
          && incoming().workspaceId == workspaceId
          && incoming().createdBy == request.auth.uid
          && request.auth.uid in incoming().memberIds
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isWorkspaceMember(workspaceId)
          && incoming().memberIds == getWorkspace(workspaceId).memberIds;
        allow update: if isVerifiedUser()
          && isValidId(workspaceId)
          && isValidId(taskId)
          && isValidTask(incoming())
          && request.auth.uid in existing().memberIds
          && incoming().id == existing().id
          && incoming().workspaceId == existing().workspaceId
          && incoming().createdBy == existing().createdBy
          && incoming().createdByName == existing().createdByName
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isWorkspaceMember(workspaceId)
          && (
            // Action: Toggle completion
            incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'completedBy', 'completedByName', 'updatedAt'])
            ||
            // Action: Edit task fields
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'description', 'priority', 'categoryId', 'categoryName',
              'dueDate', 'dueTime', 'assignee', 'updatedAt'
            ])
            ||
            // Action: Sync workspace memberIds after partner joins or leaves
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
              && incoming().memberIds == getWorkspace(workspaceId).memberIds
            )
          );
        allow delete: if isVerifiedUser()
          && isValidId(workspaceId)
          && isValidId(taskId)
          && request.auth.uid in existing().memberIds
          && isWorkspaceMember(workspaceId);
      }

      // Custom Categories subcollection
      match /categories/{categoryId} {
        allow get: if isSignedIn()
          && isValidId(workspaceId)
          && isValidId(categoryId)
          && request.auth.uid in existing().memberIds
          && isWorkspaceMember(workspaceId);
        allow list: if isSignedIn() && request.auth.uid in existing().memberIds;
        allow create: if isVerifiedUser()
          && isValidId(workspaceId)
          && isValidId(categoryId)
          && isValidCategory(incoming())
          && incoming().id == categoryId
          && incoming().workspaceId == workspaceId
          && incoming().createdBy == request.auth.uid
          && request.auth.uid in incoming().memberIds
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isWorkspaceMember(workspaceId)
          && incoming().memberIds == getWorkspace(workspaceId).memberIds;
        allow update: if isVerifiedUser()
          && isValidId(workspaceId)
          && isValidId(categoryId)
          && isValidCategory(incoming())
          && request.auth.uid in existing().memberIds
          && incoming().id == existing().id
          && incoming().workspaceId == existing().workspaceId
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && isWorkspaceMember(workspaceId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'color', 'updatedAt'])
            ||
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
              && incoming().memberIds == getWorkspace(workspaceId).memberIds
            )
          );
        allow delete: if isVerifiedUser()
          && isValidId(workspaceId)
          && isValidId(categoryId)
          && request.auth.uid in existing().memberIds
          && isWorkspaceMember(workspaceId);
      }
    }

    // Invite Code Lookup (get by exact code only, list forbidden)
    match /invites/{inviteCode} {
      allow get: if isSignedIn() && isValidInviteCode(inviteCode);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidInviteCode(inviteCode)
        && isValidInvite(incoming())
        && incoming().code == inviteCode
        && incoming().createdAt == request.time
        && workspaceExists(incoming().workspaceId)
        && getWorkspace(incoming().workspaceId).ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidInviteCode(inviteCode) && existing().ownerId == request.auth.uid;
    }
  }
}
