{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private profile for an authenticated LifeTasks user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "maxLength": 150
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "workspaceId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "photoURL", "workspaceId", "theme", "createdAt", "updatedAt"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Shared task workspace supporting up to two users.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "ownerPhoto": {
          "type": "string",
          "maxLength": 500
        },
        "partnerId": {
          "type": "string",
          "maxLength": 128
        },
        "partnerName": {
          "type": "string",
          "maxLength": 80
        },
        "partnerPhoto": {
          "type": "string",
          "maxLength": 500
        },
        "memberIds": {
          "type": "array",
          "description": "Bounded array of 1 to 2 member UIDs."
        },
        "inviteCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 12,
          "pattern": "^[A-Z0-9]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "ownerId",
        "ownerName",
        "ownerPhoto",
        "partnerId",
        "partnerName",
        "partnerPhoto",
        "memberIds",
        "inviteCode",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceInvite": {
      "title": "WorkspaceInvite",
      "description": "Short invite code lookup mapping to a workspace ID.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 6,
          "maxLength": 12,
          "pattern": "^[A-Z0-9]+$"
        },
        "workspaceId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["code", "workspaceId", "ownerId", "ownerName", "createdAt"]
    },
    "Task": {
      "title": "Task",
      "description": "A shared task with priority, category, deadline, and assignee.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberIds": {
          "type": "array",
          "description": "Bounded array of 1 to 2 workspace member UIDs."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "priority": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "categoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "categoryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "dueDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "dueTime": {
          "type": "string",
          "maxLength": 5
        },
        "assignee": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "completed": {
          "type": "boolean"
        },
        "completedBy": {
          "type": "string",
          "maxLength": 128
        },
        "completedByName": {
          "type": "string",
          "maxLength": 80
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "memberIds",
        "title",
        "description",
        "priority",
        "categoryId",
        "categoryName",
        "dueDate",
        "dueTime",
        "assignee",
        "completed",
        "completedBy",
        "completedByName",
        "createdBy",
        "createdByName",
        "createdAt",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Custom task category belonging to a shared workspace.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberIds": {
          "type": "array",
          "description": "Bounded array of 1 to 2 workspace member UIDs."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "color": {
          "type": "string",
          "enum": ["teal", "amber", "rose", "sky", "indigo", "emerald", "slate"]
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "workspaceId", "memberIds", "name", "color", "createdBy", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile storing user preferences and active workspace ID."
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Shared workspace linking up to two users."
    },
    "/invites/{inviteCode}": {
      "schema": { "$ref": "#/entities/WorkspaceInvite" },
      "description": "Invite code lookup documents for pairing a second user."
    },
    "/workspaces/{workspaceId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Tasks belonging to a shared workspace."
    },
    "/workspaces/{workspaceId}/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Custom categories belonging to a shared workspace."
    }
  }
}
